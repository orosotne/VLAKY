# =============================================================================
# Prevádzkové nastavenia Agenta dispečera – zálohy a kontrola servera
# (deploy/backup/*.sh, deploy/monitoring/check.sh, deploy/scripts/update.sh)
#
# Inštalácia (setup.sh to urobí sám, ak súbor ešte neexistuje):
#   sudo install -m 0640 -o root -g vlaky deploy/ops.env.example /etc/vlaky/ops.env
#   sudo nano /etc/vlaky/ops.env
#
# Súbor sa načítava príkazom "source" (bash): KĽÚČ=hodnota bez medzier okolo "=",
# hodnoty s medzerami do úvodzoviek. Hodnoty tu majú prednosť pred premennými prostredia.
# Obsahuje tajomstvá (heslo k zálohám) – práva 0640 root:vlaky, nikdy do gitu.
# =============================================================================

# Spôsob nasadenia: docker (Docker Compose) | systemd (inštalácia bez Dockera)
DEPLOY_MODE=docker
# Adresár repozitára (docker-compose.yml, .env)
VLAKY_APP_DIR=/opt/vlaky/app

# --- Zálohy -------------------------------------------------------------------
BACKUP_DIR=/opt/vlaky/backups
# Lokálne zálohy staršie ako N dní sa mažú; vždy zostane aspoň BACKUP_MIN_KEEP najnovších
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
# Ping po zálohe (healthchecks.io: perióda 1 deň, tolerancia 2 h); pri chybe sa volá .../fail
BACKUP_HEARTBEAT_URL=

# Len DEPLOY_MODE=systemd: pripojenie k databáze a adresár so schránkou/odoslanými
# (heslo len písmená a číslice; rovnaké ako VLAKY_DATABASE_URL v /etc/vlaky/vlaky.env)
BACKUP_DATABASE_URL=
BACKUP_FILES_ROOT=/var/lib/vlaky
# Len DEPLOY_MODE=systemd a obnova bez root-a: pripojenie správcu k databáze "postgres"
RESTORE_ADMIN_URL=

# --- Záloha mimo servera (vyber JEDNU možnosť) ---------------------------------
# a) restic (odporúčané – šifruje, deduplikuje). Repozitár raz inicializuj: restic init
#    Príklad S3 v EÚ: s3:https://s3.eu-central-1.example.com/vlaky-zalohy
#    HESLO ULOŽ AJ DO FIREMNÉHO TREZORU HESIEL – bez neho sa zálohy nedajú obnoviť!
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/vlaky/restic.pass
# prístupové kľúče k S3 úložisku (ak ho používaš) – odkomentuj:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RESTIC_FORGET_ARGS="--keep-daily 14 --keep-weekly 8 --keep-monthly 6"

# b) rclone (alternatíva): vzdialené úložisko z /etc/vlaky/rclone.conf, ideálne typ "crypt"
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/vlaky/rclone.conf
OFFSITE_RETENTION_DAYS=90

# --- Kontrola servera (deploy/monitoring/check.sh, každých 15 min) ---------------
CHECK_DISK_PATHS="/ /var/lib/docker /opt/vlaky/backups"
CHECK_DISK_MAX_PCT=85
CHECK_BACKUP_MAX_AGE_HOURS=26
CHECK_CERT_MIN_DAYS=10
# Prázdne = https://DOMÉNA/health; doména = VLAKY_DOMAIN, inak hostiteľ z VLAKY_PUBLIC_URL (https://…) v súbore
# CHECK_ENV_FILE. Neznáma doména je CHYBA (HTTPS ani certifikát by sa nekontrolovali).
CHECK_URL=
# Konfigurácia aplikácie: prázdne = $VLAKY_APP_DIR/.env (docker), /etc/vlaky/vlaky.env (systemd)
CHECK_ENV_FILE=
# Len DEPLOY_MODE=systemd: Python, ktorým check.sh spustí "python -m vlaky health" (zdravie agenta)
CHECK_PYTHON=/opt/vlaky/venv/bin/python
# Ping po kontrole (healthchecks.io: perióda 15 min, tolerancia 30 min); pri chybe .../fail s dôvodom
CHECK_HEARTBEAT_URL=
