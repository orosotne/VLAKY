# Ukážková LOKÁLNA konfigurácia s FIKTÍVNYMI dátami – nie na ostrú prevádzku.
# Použitie: cp .env.demo .env   (ostrá konfigurácia je v .env.example a docs/PREVADZKA.md)
VLAKY_ENV=dev
VLAKY_CARRIER_NAME=Ukážkový dopravca (fiktívny)
# ukážkové e-maily sú z fiktívnych domén a nemajú hlavičky SPF/DKIM/DMARC
VLAKY_ALLOWED_SENDERS=zsr.example,partner.example,zakaznik.example,dopravca.example
VLAKY_REQUIRE_DMARC_PASS=false
VLAKY_CONFIRM_THRESHOLD=0.8
# správy idú len do adresára data/odoslane (SMTP nie je nastavené)
VLAKY_NOTIFY_EMAILS=dispecer1@dopravca.example,dispecer2@dopravca.example
VLAKY_NOTIFY_PHONES=+421900000001
VLAKY_SHADOW_MODE=false
VLAKY_POSITIONS_TOKEN=lokalny-token-iba-na-ukazku
VLAKY_PUBLIC_URL=http://127.0.0.1:8000
VLAKY_DEMO_PASSWORD=ukazka-heslo-2026
