# =============================================================================
#  Agent dispečer – vzor konfigurácie. Skopíruj na .env a vyplň:
#      cp .env.example .env && chmod 600 .env && nano .env
#
#  - Nastavenia aplikácie majú predponu VLAKY_ (zoznam je vo vlaky/config.py).
#  - Riadok začínajúci znakom # je komentár. Zakomentované nastavenie (# VLAKY_...=hodnota)
#    platí s predvolenou hodnotou uvedenou za "=". Odkomentuj ho, len ak ho chceš zmeniť.
#  - Komentár píš vždy na samostatný riadok, nikdy za hodnotu (súbor čítajú Docker Compose
#    aj systemd a tie komentáre za hodnotou nespracúvajú rovnako).
#  - Hodnotu s medzerou alebo so znakom $ daj do jednoduchých úvodzoviek: '...'
#  - Číselné a áno/nie nastavenia (port, true/false …) nenechávaj prázdne – radšej ich zakomentuj.
#  - Tajomstvá (heslá, kľúče, tokeny) nepatria do gitu; .env je v .gitignore.
#    Kópiu .env ulož do firemného trezoru hesiel.
#  - Náhodné tajomstvo vygeneruješ príkazom:  openssl rand -hex 32
#  Podrobnosti: docs/PREVADZKA.md
# =============================================================================


# -----------------------------------------------------------------------------
# Server a Docker Compose (číta docker-compose.yml a Caddy, nie aplikácia)
# -----------------------------------------------------------------------------
# Doména webovej aplikácie. DNS záznam A (a AAAA) musí ukazovať na tento server;
# Caddy pre ňu sám získa a obnovuje certifikát Let's Encrypt.
VLAKY_DOMAIN=agent.dopravca.example

# PostgreSQL v kontajneri "db". Heslo je POVINNÉ, len písmená a číslice:
#   openssl rand -hex 24
# Heslo sa nastaví pri PRVOM spustení databázy; neskoršia zmena tu nestačí
# (postup zmeny je v docs/PREVADZKA.md).
POSTGRES_DB=vlaky
POSTGRES_USER=vlaky
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# Všeobecné
# -----------------------------------------------------------------------------
# Prostredie: dev | test | prod
VLAKY_ENV=prod
# Časové pásmo na zobrazovanie (časy sa ukladajú v UTC)
VLAKY_TIMEZONE=Europe/Bratislava
# POVINNÉ: tajný kľúč na podpisovanie prihlásení (session cookies) a odkazov pre rušňovodičov, aspoň 32 znakov:
#   openssl rand -hex 32
# Web v produkcii (VLAKY_ENV=prod) s prázdnym alebo slabým kľúčom odmietne štart.
# Zmena kľúča odhlási všetkých používateľov a zneplatní odkazy pre rušňovodičov.
VLAKY_SECRET_KEY=
# Verejná adresa aplikácie (odkazy v správach pre dispečera). V produkcii musí začínať https://.
# Docker: prázdne = https://VLAKY_DOMAIN. Inštalácia bez Dockera: vyplň, napr. https://agent.dopravca.example
VLAKY_PUBLIC_URL=
# Názov dopravcu (aplikácia, správy)
VLAKY_CARRIER_NAME='[NÁZOV DOPRAVCU]'
# Len pre ukážku (python -m vlaky demo) – v ostrej prevádzke nepoužívať
# VLAKY_DEMO_PASSWORD=
# IP adresy reverse proxy, ktorým sa verí hlavička X-Forwarded-For (limit prihlásení, audit).
# Docker Compose nastaví "*" (web je dostupný len cez caddy). Bez Dockera: 127.0.0.1
VLAKY_FORWARDED_ALLOW_IPS=127.0.0.1
# Mapový podklad (rastrové dlaždice {z}/{x}/{y}). Verejné dlaždice OSM nie sú určené na nepretržitú
# prevádzku – v produkcii použite vlastné dlaždice alebo komerčného poskytovateľa.
# Predvolené (verejné OSM): https://tile.openstreetmap.org/{z}/{x}/{y}.png – odkomentuj a zmeň:
# VLAKY_MAP_TILE_URL=https://dlazdice.dopravca.example/{z}/{x}/{y}.png
# VLAKY_MAP_TILE_ATTRIBUTION='© prispievatelia OpenStreetMap'
# Adresár s dátami siete (data/siet, data/hranice.json). V Dockeri NEMENIŤ.
# VLAKY_DATA_DIR=/app/data


# -----------------------------------------------------------------------------
# Databáza
# -----------------------------------------------------------------------------
# Docker Compose nastaví pripojenie AUTOMATICKY z POSTGRES_* (táto hodnota sa tam ignoruje).
# Inštalácia bez Dockera (systemd): odkomentuj a doplň heslo (len písmená a číslice):
# VLAKY_DATABASE_URL=postgresql+psycopg://vlaky:HESLO@127.0.0.1:5432/vlaky
# Bez nastavenia sa použije SQLite súbor data/vlaky.db – len na vývoj a skúšky.


# -----------------------------------------------------------------------------
# Schránka agenta – odkiaľ agent číta e-maily
# -----------------------------------------------------------------------------
# Zdroj: directory (súbory .eml v adresári – skúšky) | imap | graph (Microsoft 365)
VLAKY_MAIL_SOURCE=directory
# Ako často (sekundy) agent schránku pre istotu dočíta
VLAKY_MAIL_POLL_SECONDS=60
# Najväčšia príloha, ktorú agent spracuje (MB); väčšie len ohlási
VLAKY_MAX_ATTACHMENT_MB=15
# Prílohy sa spracúvajú v izolovanom podprocese (limity pamäte a CPU). Vypnúť len pri ladení.
# VLAKY_ATTACHMENT_SANDBOX=true

# --- directory: adresár, kam sa ukladajú súbory .eml (v Dockeri zväzok "schranka") ---
# VLAKY_MAIL_DIR=/app/data/schranka

# --- imap: Google Workspace (imap.gmail.com + heslo aplikácie) alebo iný IMAP server ---
# (pri Microsoft 365 použi graph – Exchange Online prihlásenie heslom cez IMAP nepovoľuje)
VLAKY_IMAP_HOST=
VLAKY_IMAP_PORT=993
VLAKY_IMAP_USER=
VLAKY_IMAP_PASSWORD=
VLAKY_IMAP_FOLDER=INBOX

# --- graph: Microsoft 365 cez Microsoft Graph ---
# Registrácia aplikácie v Microsoft Entra ID s aplikačným právom Mail.Read, obmedzeným
# politikou prístupu LEN na schránku agenta (postup v docs/PREVADZKA.md).
VLAKY_GRAPH_TENANT_ID=
VLAKY_GRAPH_CLIENT_ID=
# Tajomstvo klienta má obmedzenú platnosť – dátum vypršania si zapíš do kalendára!
VLAKY_GRAPH_CLIENT_SECRET=
VLAKY_GRAPH_MAILBOX=agent.dispecing@dopravca.example


# -----------------------------------------------------------------------------
# Overenie odosielateľov (e-maily od ostatných idú do karantény)
# -----------------------------------------------------------------------------
# Povolené domény alebo adresy, čiarkou oddelené (ŽSR, partneri, zákazníci, vlastní dispečeri)
VLAKY_ALLOWED_SENDERS=zsr.sk,dopravca.example
# Odosielatelia ŽSR (domény alebo adresy), ktorých výluky a trasy sa smú zapísať automaticky (ostatné idú na
# potvrdenie dispečerom). Prázdne = domény zsr.* zo zoznamu vyššie.
VLAKY_ZSR_SENDERS=
# Vyžadovať výsledok SPF/DKIM/DMARC "pass" v hlavičke Authentication-Results (v prevádzke true)
VLAKY_REQUIRE_DMARC_PASS=true
# authserv-id VÁŠHO poštového servera, čiarkou (prvé slovo hlavičky Authentication-Results,
# ktorú pridáva váš server – nájdeš ju v zdrojovom texte prijatého e-mailu; Google: mx.google.com).
# Prázdne = použije sa prvá hlavička Authentication-Results.
VLAKY_TRUSTED_AUTHSERV_IDS=


# -----------------------------------------------------------------------------
# LLM – porozumenie textu e-mailov a príloh. Bez LLM (none) agent použije pravidlá.
# -----------------------------------------------------------------------------
# Poskytovateľ: none | anthropic | openai
# Zapni až po podpise zmluvy o spracúvaní osobných údajov (DPA) – pozri docs/PREVADZKA.md.
VLAKY_LLM_PROVIDER=none
# Názov modelu podľa aktuálnej dokumentácie poskytovateľa (napr. pre anthropic: claude-opus-5-5)
VLAKY_LLM_MODEL=
VLAKY_ANTHROPIC_API_KEY=
VLAKY_OPENAI_API_KEY=
# Časový limit jedného volania (sekundy)
VLAKY_LLM_TIMEOUT_S=60
# Pod touto istotou (0 – 1) ide vytiahnutá udalosť na potvrdenie dispečerovi
VLAKY_CONFIRM_THRESHOLD=0.9
# Udalosti ovplyvňujúce vlak v najbližších N hodinách idú vždy na potvrdenie
VLAKY_CONFIRM_HORIZON_H=72


# -----------------------------------------------------------------------------
# Notifikácie – LEN interný zoznam príjemcov a tieňová prevádzka
# -----------------------------------------------------------------------------
# Agent posiela upozornenia výhradne na tieto adresy a čísla; iného príjemcu odmietne.
# Dispečeri – e-mailové adresy, čiarkou oddelené
VLAKY_NOTIFY_EMAILS=dispecer1@dopravca.example,dispecer2@dopravca.example
# Telefóny na SMS pre kritické upozornenia, čiarkou, medzinárodný formát (+421...)
VLAKY_NOTIFY_PHONES=
# Tieňová prevádzka: odporúčania idú LEN na VLAKY_SHADOW_EMAILS.
# Prvých 4 – 6 týždňov nechaj true; ostrá prevádzka až po vyhodnotení (docs/PREVADZKA.md).
VLAKY_SHADOW_MODE=true
VLAKY_SHADOW_EMAILS=veduci.dispecingu@dopravca.example
# Súhrn upozornení s prioritou INFO každých N minút
VLAKY_DIGEST_MINUTES=120
# Rovnaké upozornenie (rušňovodič, státie vlaku, pripomienky) sa nezopakuje skôr ako o N minút. Odporúčanie
# sa neopakuje, kým sa nezmení oproti poslednej správe o vlaku, ktorú dispečer dostal (návrat k skoršiemu
# odporúčaniu sa pošle).
VLAKY_DEDUP_MINUTES=180
# Kópia každej odoslanej správy (audit). V Dockeri zväzok "odoslane" – NEMENIŤ.
# VLAKY_OUTBOX_DIR=/app/data/odoslane


# -----------------------------------------------------------------------------
# SMTP – odosielanie e-mailov dispečerom
# -----------------------------------------------------------------------------
# Spôsob odosielania e-mailov dispečerom: smtp | graph (Microsoft Graph sendMail z účtu agenta;
# vhodné pre Exchange Online, kde sa ruší SMTP s heslom – aplikácia potrebuje Mail.Send obmedzené
# na schránku agenta). Pri graph sa použijú údaje VLAKY_GRAPH_* zo sekcie schránky.
VLAKY_NOTIFY_TRANSPORT=smtp
# Limit spojenia so serverom správ (SMTP, Microsoft Graph, Teams, SMS brána) v sekundách – nedostupný
# server nezdrží agenta (pri SMTP potom najviac 30 s na odpovede servera).
# VLAKY_NOTIFY_CONNECT_TIMEOUT_S=10
VLAKY_SMTP_HOST=
VLAKY_SMTP_PORT=587
VLAKY_SMTP_USER=
VLAKY_SMTP_PASSWORD=
# Adresa odosielateľa – doména musí mať SPF, DKIM a DMARC (docs/PREVADZKA.md)
VLAKY_SMTP_FROM=agent.dispecing@dopravca.example
VLAKY_SMTP_STARTTLS=true


# -----------------------------------------------------------------------------
# Microsoft Teams – kanál dispečingu (webhook z Teams Workflows)
# -----------------------------------------------------------------------------
VLAKY_TEAMS_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# SMS brána (HTTP POST JSON {"to": "+421...", "text": "..."})
# -----------------------------------------------------------------------------
VLAKY_SMS_GATEWAY_URL=
VLAKY_SMS_GATEWAY_TOKEN=


# -----------------------------------------------------------------------------
# Agent – pracovný cyklus, monitoring a heartbeat
# -----------------------------------------------------------------------------
# Ping URL externého monitoringu (napr. healthchecks.io). Agent ju volá každých
# VLAKY_HEARTBEAT_MINUTES; keď volania ustanú, monitoring upozorní dispečing.
VLAKY_HEARTBEAT_URL=
VLAKY_HEARTBEAT_MINUTES=5
# Prepočet idúcich vlakov každých N minút
VLAKY_REEVALUATE_MINUTES=15
# Hodina dennej správy o stave agenta (miestny čas)
VLAKY_DAILY_REPORT_HOUR=6
# Hodiny odovzdávky služby (miestny čas), čiarkou oddelené
VLAKY_SHIFT_CHANGE_HOURS=6,18
# Poloha staršia ako N minút je neistá (vlak sivý, nikdy zelená)
VLAKY_POSITION_STALE_MINUTES=15
# Upozornenia pred koncom pracovného času rušňovodiča (limit 13 h), minúty pred limitom
# VLAKY_CREW_ALERT_MINUTES=90,60,30
# Vlak v jazde stojí dlhšie ako N minút → upozornenie dispečerovi
# VLAKY_STANDING_ALERT_MINUTES=20
# GDPR – doby uchovávania: surové polohy (dni) a obsah e-mailov (dni; metadáta a audit ostanú); po rovnakej
# dobe ako e-maily (najmenej 3 dni) sa mažú aj správy agenta (záznamy a kópie v outboxe)
# VLAKY_RETENTION_GPS_DAYS=90
# VLAKY_RETENTION_EMAIL_DAYS=365


# -----------------------------------------------------------------------------
# Pozície vlakov (GPS brána, aplikácia rušňovodiča)
# -----------------------------------------------------------------------------
# Tajný token pre POST /api/pozicie (openssl rand -hex 32). Prázdne = rozhranie nepoužívate.
VLAKY_POSITIONS_TOKEN=


# -----------------------------------------------------------------------------
# Plánovanie – predvolené hodnoty, kým nie je vlastná história
# (meniť len po dohode s vedúcim dispečingu)
# -----------------------------------------------------------------------------
# VLAKY_DEFAULT_DELAY_P50_MIN_PER_100KM=5.0
# VLAKY_DEFAULT_DELAY_P90_MIN_PER_100KM=25.0
# VLAKY_FREIGHT_VMAX_KMH=100.0
# VLAKY_HORIZON_HOURS=24
# VLAKY_STEP_MINUTES=10
